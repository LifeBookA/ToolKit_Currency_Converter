{
    "name": "lifebooka/toolkit-currency-converter",
    "description": "Currency Converter with File Cache and Multiple Providers",
    "type": "library",
    "keywords": ["currency", "converter", "exchange-rate", "cache", "forex"],
    "require": {
        "php": "^8.1",
        "psr/log": "^3.0"
    },
    "require-dev": {
        "phpunit/phpunit": "^10.0"
    },
    "license": "MIT",
    "authors": [
        {
            "name": "LifeBookA"
        }
    ],
    "autoload": {
        "psr-4": {
            "Toolkit\\Currency\\": "src/Currency/"
        }
    },
    "autoload-dev": {
        "psr-4": {
            "Toolkit\\Currency\\Tests\\": "tests/"
        }
    },
    "scripts": {
        "test": "phpunit",
        "test:unit": "phpunit --testsuite Unit",
        "test:integration": "phpunit --testsuite Integration"
    }
}
